LANGSMITH_PROJECT="incident-swarm"
LANGSMITH_TRACING="true"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# MongoDB — `docker compose up -d` gives a replica set (change streams) plus mongot
# (Atlas Vector Search) in one container.
MONGODB_URI="mongodb://swarm:swarm@localhost:27018/?directConnection=true"
MONGODB_DB="incident_swarm"

SWARM_MODEL="anthropic:claude-sonnet-5"
SWARM_EMBEDDING_MODEL="text-embedding-3-small"

# Pacing: milliseconds an agent waits before acting on a change event. Eight LLM agents
# on change streams converge faster than a presenter can narrate; this is the throttle.
SWARM_PACE_MS="2500"

# Per-agent LLM-call budget per incident. Load-bearing: without it, agents reacting to
# each other's writes amplify without bound.
SWARM_MAX_CYCLES="12"

# Escape valves (seconds). Stigmergic convergence does not naturally terminate.
SWARM_PHASE1_TIMEOUT="240"
SWARM_PHASE2_TIMEOUT="240"
